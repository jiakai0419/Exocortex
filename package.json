{
  "name": "exocortex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:check": "node tools/verify.mjs --generated-only",
    "check": "npm run build && node tools/check-syntax.mjs",
    "help": "node bin/exocortex.mjs --help",
    "test": "npm run build && node --test --test-concurrency=4 tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "node tools/verify.mjs",
    "exo": "node bin/exocortex.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  }
}
