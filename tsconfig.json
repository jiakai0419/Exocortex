{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "bin/**/*.mjs",
    "tools/**/*.mjs",
    "src/**/*.ts",
    "src/**/*.mjs"
  ]
}
